# Copy to .env.local and fill in. Never commit the filled file.

# --- Supabase (required) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS - must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI advisor (required only for the narrative layer) --------------------
# Without any provider key, /api/advisor/diagnose still returns a full
# deterministic diagnosis; only the written narrative is omitted.
#
# Which provider to use: "gemini" or "claude". If unset, whichever key is
# present wins, preferring Gemini (it has a free tier).
AI_PROVIDER=gemini

# Gemini (free tier available at aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional comma-separated fallback chain. Defaults to four flash models,
# because free-tier availability flickers and single models return 503 often.
GEMINI_MODEL=

# Claude (paid; no free tier - a Claude subscription does NOT include API access)
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-opus-5.
ANTHROPIC_MODEL=

# --- CORS (required in production) ----------------------------------------
# Comma-separated origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000

# --- Verification emails (optional) ---------------------------------------
# Frontend URL used to build verification links. Without it links point at the API host.
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Distributed rate limiting (recommended in production) ----------------
# Without these, rate limits are in-memory and therefore per-instance, which on
# serverless means effectively unenforced.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
